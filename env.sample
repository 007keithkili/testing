# Copy this file to .env and fill in the values for your environment.

# Core
SECRET_KEY=change-me-to-a-long-random-string
FLASK_CONFIG=development
SITE_URL=http://localhost:5000
API_BASE=/api/v1

# Database (SQLite by default, PostgreSQL in production)
# Relative SQLite paths are resolved inside the instance/ folder.
SQLALCHEMY_DATABASE_URI=sqlite:///data-dev.sqlite
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://user:password@localhost:5432/remotetravels
TESTING_DATABASE_URI=sqlite:///data-test.sqlite

# Uploads (CVs and itineraries)
UPLOAD_FOLDER=instance/uploads

# Mail (contact form + newsletter notifications)
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=info@remotetravels.co.ke
MAIL_ADMIN=info@remotetravels.co.ke

# Server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=1

# Card payments - Flutterwave (https://dashboard.flutterwave.com > Settings > API keys)
# Use TEST keys while developing (they start with FLWSECK_TEST-). NEVER commit real keys.
FLW_SECRET_KEY=
# Any long random string; paste the SAME value in Flutterwave > Settings > Webhooks > Secret hash
FLW_SECRET_HASH=
PAYMENT_CURRENCY=USD
# 100 = customer pays the full price online, 30 = 30% deposit, etc.
PAYMENT_DEPOSIT_PERCENT=100
